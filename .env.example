PAGEWEAVE_HOST=0.0.0.0
PAGEWEAVE_PORT=7779
PAGEWEAVE_BROWSER_PATH=/usr/bin/chromium
PAGEWEAVE_MAX_CONCURRENCY=2
PAGEWEAVE_REQUEST_TIMEOUT_SECONDS=25
PAGEWEAVE_NAVIGATION_TIMEOUT_SECONDS=10
PAGEWEAVE_RENDER_WAIT_SECONDS=5
PAGEWEAVE_MAX_HTML_BYTES=2097152
PAGEWEAVE_MAX_REQUEST_BYTES=16384
PAGEWEAVE_MAX_OUTPUT_CHARS=50000
PAGEWEAVE_MAX_SCROLL_STEPS=3
PAGEWEAVE_LOG_LEVEL=INFO
# Compose only:
PAGEWEAVE_IMAGE=ghcr.io/dreamdonghao/pageweave:latest
PAGEWEAVE_NETWORK=pageweave-tools
